# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Gemini (Tuần 2: chatbot QnA trả lời bằng Gemini, giới hạn trong lib/mock-data.ts -> qnaEntries)
GEMINI_API_KEY=
# Model Gemini dùng cho chatbot, bỏ trống để dùng mặc định "gemini-3.8-flash"
GEMINI_MODEL=

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
